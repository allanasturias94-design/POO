        <mxCell id="PuRR1LuSJgoLwzaryRYl-40" parent="PuRR1LuSJgoLwzaryRYl-1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;line-height: 90%;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 10px; line-height: 90%;&quot;&gt;Sistema muestra el estado del Patrono y la sección&amp;nbsp;&lt;b&gt;“Operaciones en Registro de Patrono”&lt;/b&gt;, la cual contiene los siguientes componentes:&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 10px; line-height: 90%;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 10px; line-height: 90%;&quot;&gt;•&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); text-align: center;&quot;&gt;&lt;font style=&quot;font-size: 10px; line-height: 90%;&quot;&gt;Muestra tabla con No. (correlativo), tipo de operación y fecha, permitiendo seleccionar Suspensión, Reanudación o Cancelación.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 10px; line-height: 90%;&quot;&gt;•&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 10px; line-height: 90%;&quot;&gt;Muestra establecimientos con número, nombre, ubicación, fechas y estado de contribuciones, permitiendo seleccionar un establecimiento.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 10px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); line-height: 90%;&quot;&gt;• &lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 10px; line-height: 90%;&quot;&gt;Muestra contratos con número de registro, número, tipo y nombre, permitiendo seleccionar un contrato.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="134" width="240" x="20" y="203" as="geometry" />
