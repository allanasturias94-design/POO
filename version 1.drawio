        <mxCell id="nh5n_6B2fXmda3D-zmYl-51" parent="1" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=left;fillColor=#cce5ff;strokeColor=#36393d;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;El analista ingresa al sistema AS400, el sistema muestra los comandos con los tipos de operación que puede realizar.&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;b style=&quot;font-weight: bold;&quot;&gt;60. &lt;/b&gt;Inscripciones&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;b&gt;61. &lt;/b&gt;Modificación&lt;/div&gt;&lt;div style=&quot;font-weight: bold; text-align: justify;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;62&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-weight: normal;&quot;&gt;. Cancelaciones&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;b&gt;63&lt;/b&gt;. Cancelaciones&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;b&gt;64&lt;/b&gt;. Anulación de Patronos&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;b&gt;65.&lt;/b&gt; Nuevamente en vigor&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;b&gt;66.&lt;/b&gt; Ins. Patronos Estado.&lt;/div&gt;" vertex="1">
